---
import Layout from "../layouts/Layout.astro";
import { PADS, padColor } from "../scripts/pads";
---

<Layout
  title="Rainbow DJ"
  description="A browser DJ set — a jog platter, a mixer with volume/pitch/cue, a beat machine, a recorder, and twelve coloured pads of live synthesised sound."
>
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>Rainbow DJ</h1>
    <p class="hint">
      Press a pad — mouse, touch, or the number/symbol row. Spin the jog
      wheel, dial in the pitch, ride the volume fader, record a loop and let
      Play beat play it back. Every sound is made live, right here — no two
      hits quite the same.
    </p>

    <div class="cabinet">
      <canvas id="viz" width="900" height="140" aria-hidden="true"></canvas>

      <div class="rack">
        <div class="turntable-unit">
          <button
            type="button"
            id="jog"
            class="jog"
            aria-label="Spin the jog wheel — plays a random scratch move"
          >
            <span class="jog-platter">
              <span class="jog-grip"></span>
              <span class="jog-marker"></span>
              <span class="jog-hub">JOG</span>
            </span>
          </button>
          <p class="unit-caption">Jog wheel — scratch it</p>
        </div>

        <div class="deck" id="deck" role="group" aria-label="DJ pads">
          {
            PADS.map((pad) => (
              <button
                type="button"
                class="pad"
                data-sound={pad.id}
                data-key={pad.key}
                style={`--pad: ${padColor(pad.hue)};`}
              >
                <span class="label">{pad.label}</span>
                <span class="key">{pad.key}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="mixer" role="group" aria-label="Mixer controls">
        <div class="mixer-section mixer-section-channel">
          <span class="mixer-section-title">Channel</span>
          <div class="faders">
            <label class="fader-group">
              <span class="fader-label">Vol</span>
              <span class="fader-track">
                <input type="range" id="volume" min="0" max="1.2" step="0.01" value="0.9" aria-label="Volume" />
              </span>
            </label>
            <label class="fader-group">
              <span class="fader-label">Pitch</span>
              <span class="fader-track">
                <input type="range" id="pitch" min="-8" max="8" step="1" value="0" aria-label="Pitch" />
              </span>
              <span class="fader-readout" id="pitch-label">+0%</span>
            </label>
          </div>
        </div>

        <div class="mixer-section">
          <span class="mixer-section-title">Beats</span>
          <button type="button" id="beats-btn" class="mixer-btn" aria-pressed="false">
            <span class="led"></span>
            <span class="btn-text">Play beat</span>
          </button>
          <button type="button" id="cue-btn" class="mixer-btn">
            <span class="led led-red"></span>
            <span>Cue</span>
          </button>
          <span class="bpm" id="bpm-label">128 BPM</span>
        </div>

        <div class="mixer-section">
          <span class="mixer-section-title">Looper</span>
          <button type="button" id="record-btn" class="mixer-btn mixer-btn-record" aria-pressed="false">
            <span class="led led-red"></span>
            <span class="btn-text">Record</span>
          </button>
          <span class="fader-readout" id="record-timer">0.0s</span>
        </div>
      </div>
    </div>

    <p class="status" id="status" role="status" aria-live="polite">
      Tap a pad, spin the jog wheel, or start the beat.
    </p>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>

<style>
  main {
    max-width: 60rem;
  }

  .hint {
    color: #b9b9c2;
  }

  kbd {
    font-family: ui-monospace, monospace;
    background: #1c1c22;
    color: #e8e8ee;
    border-radius: 0.25rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid #3a3a44;
  }

  /* --- the cabinet: brushed-metal chassis holding everything --- */
  .cabinet {
    position: relative;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background:
      repeating-linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.03) 0px,
        rgba(255, 255, 255, 0.03) 1px,
        transparent 1px,
        transparent 3px
      ),
      linear-gradient(160deg, #2b2b32, #17171b 60%, #0d0d10);
    border: 1px solid #000;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -2px 6px rgba(0, 0, 0, 0.6),
      0 1.5rem 3rem rgba(0, 0, 0, 0.6);
  }

  .cabinet::before,
  .cabinet::after {
    content: "";
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    top: 0.6rem;
    background: radial-gradient(circle at 35% 35%, #ddd, #555 70%, #111);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.6);
  }

  .cabinet::before {
    left: 0.6rem;
  }

  .cabinet::after {
    right: 0.6rem;
  }

  canvas#viz {
    width: 100%;
    height: 8.5rem;
    display: block;
    margin-bottom: 1.25rem;
    border-radius: 0.6rem;
    background: #000;
    border: 1px solid #000;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .rack {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (max-width: 40rem) {
    .rack {
      grid-template-columns: 1fr;
    }
  }

  /* --- jog platter (CDJ-style, no tonearm) --- */
  .turntable-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .jog {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid #444;
    background: radial-gradient(circle at 35% 30%, #555, #1a1a1c 65%);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    padding: 0.6rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .jog:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .jog-platter {
    position: relative;
    width: 84%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-conic-gradient(from 0deg, #101012 0deg 6deg, #1c1c1f 6deg 12deg);
    box-shadow: inset 0 0 1rem rgba(0, 0, 0, 0.8), 0 0 0 2px #000;
    animation: spin 1.8s linear infinite;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .jog.scratching .jog-platter {
    animation: scratch-wobble 0.55s ease-in-out;
  }

  .jog-grip {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle,
      rgba(255, 255, 255, 0.03) 0px,
      rgba(255, 255, 255, 0.03) 1px,
      transparent 1px,
      transparent 5px
    );
  }

  .jog-marker {
    position: absolute;
    top: 4%;
    left: 50%;
    width: 3px;
    height: 14%;
    background: #ff8c1a;
    border-radius: 2px;
    transform: translateX(-50%);
    box-shadow: 0 0 0.35rem #ff8c1a;
  }

  .jog-hub {
    position: relative;
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #444, #000 75%);
    box-shadow: 0 0 0 2px #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ff8c1a;
  }

  .unit-caption {
    margin: 0;
    font-size: 0.75rem;
    color: #8a8a95;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes scratch-wobble {
    0% {
      transform: rotate(0deg);
    }
    15% {
      transform: rotate(-70deg);
    }
    30% {
      transform: rotate(20deg);
    }
    45% {
      transform: rotate(-45deg);
    }
    60% {
      transform: rotate(10deg);
    }
    75% {
      transform: rotate(-25deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  /* --- pads: fixed divisor column counts so 12 pads always tile with zero
     leftover cells, while aspect-ratio keeps every cell square --- */
  .deck {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.65rem;
    align-content: start;
  }

  @media (max-width: 56rem) {
    .deck {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 34rem) {
    .deck {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 22rem) {
    .deck {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pad {
    --pad: #999;
    position: relative;
    aspect-ratio: 1;
    border: none;
    border-radius: 1rem;
    background: linear-gradient(160deg, var(--pad), color-mix(in srgb, var(--pad) 60%, black));
    color: #fff;
    font-family: system-ui, sans-serif;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    box-shadow: 0 0.25rem 0 color-mix(in srgb, var(--pad) 45%, black), 0 0.5rem 1rem rgba(0, 0, 0, 0.4);
    transition: transform 0.05s ease, box-shadow 0.05s ease;
    touch-action: manipulation;
  }

  .pad .label {
    font-size: clamp(0.65rem, 1.6vw, 0.95rem);
    letter-spacing: 0.02em;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    text-align: center;
  }

  .pad .key {
    font-size: clamp(0.55rem, 1.1vw, 0.7rem);
    opacity: 0.85;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 0.3rem;
    padding: 0 0.35rem;
  }

  .pad:active,
  .pad.hit {
    transform: translateY(0.2rem);
    box-shadow: 0 0.05rem 0 color-mix(in srgb, var(--pad) 45%, black), 0 0.15rem 0.4rem rgba(0, 0, 0, 0.4);
  }

  .pad:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  /* --- mixer strip --- */
  .mixer {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 0.9rem 1.1rem;
    border-radius: 0.75rem;
    background: linear-gradient(180deg, #1c1c22, #0f0f12);
    border: 1px solid #000;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .mixer-section {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .mixer-section-channel {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .faders {
    display: flex;
    gap: 1.25rem;
  }

  .fader-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: #9a9aa4;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .fader-track {
    width: 2.4rem;
    height: 6rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fader-track input[type="range"] {
    width: 6rem;
    transform: rotate(-90deg);
    accent-color: #ff8c1a;
  }

  .fader-readout {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: #7a7a85;
  }

  .mixer-section-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #7a7a85;
    min-width: 3.5rem;
  }

  .mixer-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: linear-gradient(180deg, #333339, #202024);
    color: #eaeaef;
    border: 1px solid #000;
    border-radius: 0.5rem;
    padding: 0.5rem 0.8rem;
    font-family: system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: 0 0.15rem 0 #000, inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .mixer-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .mixer-btn:active:not(:disabled) {
    transform: translateY(0.1rem);
    box-shadow: 0 0.05rem 0 #000, inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .mixer-btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  .led {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #333;
    box-shadow: inset 0 0 2px #000;
  }

  .mixer-btn[aria-pressed="true"] .led {
    background: #2ecc40;
    box-shadow: 0 0 0.4rem #2ecc40;
  }

  .led-red {
    background: #3a1010;
  }

  #record-btn[aria-pressed="true"] .led-red {
    background: #ff2d2d;
    box-shadow: 0 0 0.5rem #ff2d2d;
    animation: pulse 1s ease-in-out infinite;
  }

  #cue-btn:active .led-red {
    background: #ff2d2d;
    box-shadow: 0 0 0.5rem #ff2d2d;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .bpm {
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: #7a7a85;
  }

  .status {
    margin-top: 1rem;
    color: #b9b9c2;
    min-height: 1.5rem;
  }
</style>
